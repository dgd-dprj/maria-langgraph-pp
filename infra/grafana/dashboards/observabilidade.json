      {
        "id": 4,
        "title": "Issue #85 — Conclusão vs handoff, por fluxo e ambiente",
        "type": "barchart",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": { "type": "cloudwatch", "uid": "ffymvx5sukwlce" },
        "targets": [
          {
            "datasource": { "type": "cloudwatch", "uid": "ffymvx5sukwlce" },
            "queryMode": "Logs",
            "region": "us-east-1",
            "logGroups": [
              { "arn": "/ecs/maria-langgraph-pp/api", "name": "/ecs/maria-langgraph-pp/api" },
              { "arn": "/ecs/maria-langgraph-pp-release/api", "name": "/ecs/maria-langgraph-pp-release/api" }
            ],
            "expression": "fields @log, fluxoId, motivoHandoff\n| filter evento = \"atendimento_finalizado\"\n| fields replace(replace(@log, \"185327115563:/ecs/maria-langgraph-pp-release/api\", \"release\"), \"185327115563:/ecs/maria-langgraph-pp/api\", \"prod\") as ambiente\n| fields replace(replace(fluxoId, \"3df874f2-675a-4c43-9ec7-480f7c702f50\", \"pessoa-presa\"), \"cabb2495-4e12-4f4a-9956-3d20649059bc\", \"violencia-domestica\") as fluxoNome\n| stats count(*) as total by ambiente, fluxoNome, ispresent(motivoHandoff) as ehHandoff",
            "statsGroups": ["ambiente", "fluxoNome", "ehHandoff"],
            "refId": "A"
          }
        ]
      },
