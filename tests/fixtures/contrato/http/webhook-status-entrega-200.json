{
  "nome": "webhook-status-entrega-200",
  "descricao": "Webhook de status de entrega (sem mensagem): só ok",
  "instancia": {
    "nome": "a-test-classificacao-pessoa-presa",
    "env": {
      "NODE_ENV": "test",
      "MOCK_CLASSIFICACAO_FLOWID": "3df874f2-675a-4c43-9ec7-480f7c702f50",
      "WHATSAPP_VERIFY_TOKEN": "token-verificacao-captura"
    }
  },
  "requisicao": {
    "metodo": "POST",
    "caminho": "/webhook/whatsapp",
    "headers": {
      "content-type": "application/json"
    },
    "corpo": {
      "entry": [
        {
          "changes": [
            {
              "value": {
                "statuses": [
                  {
                    "status": "delivered"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "resposta": {
    "status": 200,
    "contentType": "application/json; charset=utf-8",
    "location": null,
    "corpoBruto": "{\"ok\":true}",
    "corpo": {
      "ok": true
    }
  }
}
