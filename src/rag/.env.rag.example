# Banco local exclusivo do RAG (docker-compose.yml, porta 55433).
DATABASE_URL=

# Credenciais AWS já configuradas no computador. Use AWS_PROFILE ou as variáveis
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY no ambiente; não coloque chaves reais
# neste arquivo de exemplo.
AWS_PROFILE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_SIMILARITY_THRESHOLD=0.25

# Recuperação do catálogo do orquestrador: desligada por padrão, como na #353.
# O valor é lido em cada busca; somente a string exata "true" ativa o RRF.
ORQUESTRADOR_BUSCA_HIBRIDA=false
