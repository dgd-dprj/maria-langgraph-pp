            ],
            "expression": "fields @log, fluxoId, tokensGastos.total as tokensTotal\n| filter evento = \"atendimento_finalizado\"\n| fields replace(replace(@log, \"185327115563:/ecs/maria-langgraph-pp-release/api\", \"release\"), \"185327115563:/ecs/maria-langgraph-pp/api\", \"prod\") as ambiente\n| fields replace(replace(fluxoId, \"3df874f2-675a-4c43-9ec7-480f7c702f50\", \"pessoa-presa\"), \"cabb2495-4e12-4f4a-9956-3d20649059bc\", \"violencia-domestica\") as fluxoNome\n| stats sum(tokensTotal) as tokensPorDia by bin(1d), ambiente, fluxoNome",
