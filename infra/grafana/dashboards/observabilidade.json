      {
        "id": 11,
        "title": "Issue #82 — Desfecho dos atendimentos concluídos (agendamento, humano, outro), por fluxo e ambiente",
        "type": "barchart",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "datasource": { "type": "cloudwatch", "uid": "ffymvx5sukwlce" },
        "targets": [
          {
            "datasource": { "type": "cloudwatch", "uid": "ffymvx5sukwlce" },
            "queryMode": "Logs",
            "region": "us-east-1",
            "logGroups": [
              { "arn": "/ecs/maria-langgraph-pp/api", "name": "/ecs/maria-langgraph-pp/api" },
              { "arn": "/ecs/maria-langgraph-pp-release/api", "name": "/ecs/maria-langgraph-pp-release/api" }
            ],
            "expression": "fields @log, fluxoId, destino\n| filter evento = \"atendimento_finalizado\"\n| fields replace(replace(@log, \"185327115563:/ecs/maria-langgraph-pp-release/api\", \"release\"), \"185327115563:/ecs/maria-langgraph-pp/api\", \"prod\") as ambiente\n| fields replace(replace(fluxoId, \"3df874f2-675a-4c43-9ec7-480f7c702f50\", \"pessoa-presa\"), \"cabb2495-4e12-4f4a-9956-3d20649059bc\", \"violencia-domestica\") as fluxoNome\n| fields coalesce(destino, \"sucesso_sem_destino\") as desfecho\n| stats count(*) as total by ambiente, fluxoNome, desfecho",
            "statsGroups": ["ambiente", "fluxoNome", "desfecho"],
            "refId": "A"
          }
        ]
